# Local development uses Vite's /api proxy to http://localhost:8000.
# Production must set this to the real public HTTPS backend, including any API prefix.
# VITE_API_BASE_URL=https://your-backend.example/api/v1
# Enable the operator token prompt against a protected local development backend.
# VITE_REQUIRE_AUTH=true

# GitHub Pages deployment sets these automatically.
# VITE_BASE_PATH=/Traffic-Accident-Detection-Frontend/
# VITE_ROUTER_MODE=hash
# Explicitly allow publishing only the "Backend not configured" screen until a backend exists.
# VITE_ALLOW_UNCONFIGURED_BACKEND=true
